# ClearCue environment template.
# Copy to `.env` (never committed) and fill in values from the Firebase console.
#
# These Firebase web identifiers are project configuration, not secrets. The
# App Check debug token is a local development secret: keep it out of git,
# screenshots and release builds.

# Firebase project -> Project settings -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud-hosted Gemini model used for IN_CLOUD inference.
# Verified 2026-11-24 against Firebase AI Logic docs: `gemini-3.5-flash-lite`
# is a featured Flash-Lite model and the SDK default hybrid fallback (v13.0.0+).
# Override only with a model listed as available for your project in
# Firebase console -> AI Logic -> Models.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# App Check for local development.
# Option A (documented debug provider): let the SDK generate a debug token and
# print it to the extension console, then register that token in the Firebase
# console under App Check -> Apps -> Manage debug tokens.
VITE_APPCHECK_DEBUG=true
# Option B: supply an already-registered debug token explicitly.
# VITE_APPCHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000

# Release builds omit all project configuration and ship a deterministic local core.
# Production cloud requires verified attestation. See docs/STAGE7_RELEASE.md.

# Optional: default temperature requested from the cloud model.
# VITE_CLOUD_TEMPERATURE=0.2
